{
  "name": "@rokoyfa/calendar",
  "version": "1.1.0",
  "description": "Embeddable calendar for React and any website: day, week, month and year views, recurring and all-day events, time zones, drag and drop, teams and eight languages, as a React component or a <calendar-widget> web component.",
  "keywords": [
    "calendar",
    "react",
    "web-component",
    "custom-element",
    "scheduler",
    "events",
    "embeddable",
    "widget",
    "i18n",
    "timezone",
    "drag-and-drop",
    "recurring-events"
  ],
  "license": "MIT",
  "author": "Rokoyfa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rokoyfa/Calendar.git"
  },
  "homepage": "https://github.com/Rokoyfa/Calendar#readme",
  "bugs": {
    "url": "https://github.com/Rokoyfa/Calendar/issues"
  },
  "type": "module",
  "main": "./dist-lib/npm/index.js",
  "module": "./dist-lib/npm/index.js",
  "types": "./dist-lib/npm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/npm/index.d.ts",
      "import": "./dist-lib/npm/index.js"
    },
    "./cdn": "./dist-lib/cdn/calendar-widget.js",
    "./openapi.yaml": "./api/openapi.yaml",
    "./config.schema.json": "./schema/calendar-config.schema.json",
    "./package.json": "./package.json"
  },
  "jsdelivr": "./dist-lib/cdn/calendar-widget.js",
  "unpkg": "./dist-lib/cdn/calendar-widget.js",
  "sideEffects": [
    "./dist-lib/cdn/*"
  ],
  "files": [
    "dist-lib",
    "api/openapi.yaml",
    "schema",
    "demo/calendar.config.yaml",
    "demo/calendar.config.jsonc",
    "DEVELOPER_GUIDE.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:lib": "node -e \"require('fs').rmSync('dist-lib',{recursive:true,force:true})\" && vite build -c vite.lib.config.ts && vite build -c vite.lib.config.ts --mode element && tsc -p tsconfig.lib.json && node scripts/collect-types.mjs",
    "typecheck": "tsc -b",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build:lib",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "date-holidays": "^3.39.1",
    "yaml": "^2.9.1"
  }
}
